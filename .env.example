POSTGRES_DB=voxhire
POSTGRES_USER=voxhire
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://voxhire:change-this-local-password@localhost:5432/voxhire
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-random-local-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=voxhire_refresh_token
REFRESH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
